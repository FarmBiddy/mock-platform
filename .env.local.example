# Base URL of the external FarmBiddy Financial Engine (no trailing slash).
# The engine must be started separately, e.g. python run_server.py
FINANCIAL_ENGINE_URL=http://127.0.0.1:8000
# Service token: required by the engine when it runs with ENGINE_API_KEY set (server-side only, never NEXT_PUBLIC_).
# ENGINE_API_KEY=

# Biddy (Ask Biddy). Leave unset to use the mock agent in data/biddy/fixtures.json.
# BIDDY_URL=http://127.0.0.1:8100
